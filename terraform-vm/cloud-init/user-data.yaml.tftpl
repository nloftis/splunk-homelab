#cloud-config
hostname: ${hostname}
timezone: ${timezone}
fqdn: ${hostname}.home.arpa

users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: '${admin_password_hash}'
    ssh_authorized_keys:
      - ${ssh_public_key}

# Password auth disabled — SSH key is the only way in.
ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: true

packages:
  - qemu-guest-agent
  - curl
  - gnupg
  - apt-transport-https

write_files:
  - path: /usr/local/sbin/install-splunk.sh
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, splunk_install_script)}

runcmd:
  - systemctl enable --now qemu-guest-agent
  - /usr/local/sbin/install-splunk.sh
